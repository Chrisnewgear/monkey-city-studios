---
import CodeWindow from './CodeWindow.astro';

const stats = [
  { value: "100+", label: "Projects shipped" },
  { value: "98%", label: "Client satisfaction" },
  { value: "5+", label: "Years building" },
];
---

<section class="hero" id="hero">
  <div class="hero-backdrop" aria-hidden="true">
    <div class="hero-orb hero-orb--1"></div>
    <div class="hero-orb hero-orb--2"></div>
    <div class="hero-orb hero-orb--3"></div>
    <div class="hero-grid"></div>
    <canvas class="hero-particles" id="hero-particles"></canvas>
  </div>

  <div class="container hero-inner">
    <div class="hero-content">
      <span class="hero-badge">
        <span class="hero-badge-dot"></span>
        Digital product studio · Available for new work
      </span>

      <h1>
        We build software that<br />
        <span class="hero-accent">moves you forward.</span>
      </h1>

      <p class="hero-subtitle">
        Monkey City Studios partners with founders and growing teams to design,
        engineer, and ship ambitious web and mobile products — from first
        concept to scaled platform.
      </p>

      <div class="hero-cta">
        <a href="/contact" class="btn btn--primary btn--lg">
          Start your project
          <svg class="btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="#tech-stack" class="btn btn--ghost-light btn--lg">View our stack</a>
      </div>

      <dl class="hero-stats">
        {stats.map((stat) => (
          <div class="hero-stat">
            <dt>{stat.value}</dt>
            <dd>{stat.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hero-visual">
      <div class="hero-visual-glow" aria-hidden="true"></div>
      <div class="hero-visual-inner">
        <CodeWindow />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(120% 90% at 78% -10%, color-mix(in oklab, var(--azure-700), transparent 70%), transparent 60%),
      linear-gradient(165deg, var(--navy-800), var(--navy-900) 72%);
    color: var(--on-dark);
    padding-block: clamp(7rem, 12vw, 10rem) clamp(4rem, 8vw, 7rem);
    /* Smoothed pointer position, -1..1, driven by JS rAF loop */
    --mx: 0;
    --my: 0;
  }

  /* Interactive, parallaxed brand field */
  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* Soft, blurred brand orbs that drift opposite the cursor for depth */
  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    will-change: transform;
    transition: transform 600ms var(--ease-out);
  }
  .hero-orb--1 {
    top: -12%;
    right: 2%;
    width: 38vw;
    max-width: 560px;
    aspect-ratio: 1;
    background: radial-gradient(circle, color-mix(in oklab, var(--pulse), transparent 30%), transparent 68%);
    transform: translate3d(calc(var(--mx) * 34px), calc(var(--my) * 26px), 0);
  }
  .hero-orb--2 {
    bottom: -18%;
    left: -6%;
    width: 42vw;
    max-width: 620px;
    aspect-ratio: 1;
    background: radial-gradient(circle, color-mix(in oklab, var(--azure), transparent 40%), transparent 68%);
    transform: translate3d(calc(var(--mx) * -46px), calc(var(--my) * -30px), 0);
  }
  .hero-orb--3 {
    top: 32%;
    left: 46%;
    width: 26vw;
    max-width: 360px;
    aspect-ratio: 1;
    opacity: 0.4;
    background: radial-gradient(circle, color-mix(in oklab, var(--azure-700), transparent 35%), transparent 70%);
    transform: translate3d(calc(var(--mx) * 20px), calc(var(--my) * -18px), 0);
  }

  /* Fine grid, faint, parallaxed a hair against the orbs */
  .hero-grid {
    position: absolute;
    inset: -4%;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(120% 100% at 70% 0%, #000 35%, transparent 78%);
    mask-image: radial-gradient(120% 100% at 70% 0%, #000 35%, transparent 78%);
    will-change: transform;
    transform: translate3d(calc(var(--mx) * -14px), calc(var(--my) * -10px), 0);
  }

  /* Interactive constellation network */
  .hero-particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-inner {
    position: relative;
    z-index: var(--z-base);
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .hero-content {
    animation: rise 700ms var(--ease-out) both;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--on-dark);
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: var(--space-6);
  }
  .hero-badge-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3ddc97;
    box-shadow: 0 0 0 4px color-mix(in oklab, #3ddc97, transparent 78%);
  }
  /* Living "available" indicator — a soft ring breathing outward */
  .hero-badge-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #3ddc97;
    animation: dot-pulse 2.4s var(--ease-out) infinite;
  }
  @keyframes dot-pulse {
    0% { transform: scale(1); opacity: 0.6; }
    70%, 100% { transform: scale(2.6); opacity: 0; }
  }

  .hero h1 {
    color: #fff;
    font-size: var(--step-5);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-5);
  }
  .hero-accent { color: var(--pulse); }

  .hero-subtitle {
    color: var(--on-dark-muted);
    font-size: var(--step-1);
    line-height: 1.6;
    max-width: 52ch;
    margin-bottom: var(--space-7);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin: 0;
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  /* Stagger the stats in after the content block settles */
  .hero-stat {
    opacity: 0;
    animation: rise 600ms var(--ease-out) both;
  }
  .hero-stat:nth-child(1) { animation-delay: 420ms; }
  .hero-stat:nth-child(2) { animation-delay: 480ms; }
  .hero-stat:nth-child(3) { animation-delay: 540ms; }
  .hero-stat dt {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .hero-stat dd {
    margin: 0.4rem 0 0;
    font-size: 0.85rem;
    color: var(--on-dark-muted);
  }

  .hero-visual {
    position: relative;
    perspective: 1200px;
    animation: rise 800ms var(--ease-out) 120ms both;
  }
  .hero-visual-glow {
    position: absolute;
    inset: -12% -8% -8% -4%;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--pulse), transparent 70%), transparent);
    filter: blur(8px);
    z-index: 0;
  }
  /* Subtle 3D tilt toward the cursor for tactile depth */
  .hero-visual-inner {
    position: relative;
    z-index: 1;
    will-change: transform;
    transform: rotateY(calc(var(--mx) * 5deg)) rotateX(calc(var(--my) * -5deg)) translateZ(0);
    transform-style: preserve-3d;
    transition: transform 400ms var(--ease-out);
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .hero-visual { order: 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-content,
    .hero-visual,
    .hero-badge-dot::after { animation: none; }
    .hero-stat { opacity: 1; animation: none; }
    /* Freeze all pointer-driven motion */
    .hero-orb,
    .hero-grid,
    .hero-visual-inner { transform: none; transition: none; }
  }
</style>

<script>
  const hero = document.getElementById('hero') as HTMLElement | null;
  const canvas = document.getElementById('hero-particles') as HTMLCanvasElement | null;
  if (hero && canvas) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    /* ---- Pointer parallax (smoothed in the rAF loop) ---- */
    let targetX = 0, targetY = 0;   // -1..1, raw from pointer
    let curX = 0, curY = 0;         // eased values written to CSS vars

    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      targetX = ((e.clientX - r.left) / r.width - 0.5) * 2;
      targetY = ((e.clientY - r.top) / r.height - 0.5) * 2;
      pointer.x = e.clientX - r.left;
      pointer.y = e.clientY - r.top;
      pointer.active = true;
    });
    hero.addEventListener('pointerleave', () => {
      targetX = 0; targetY = 0;
      pointer.active = false;
    });

    /* ---- Constellation particle field ---- */
    const ctx = canvas.getContext('2d', { alpha: true })!;
    const pointer = { x: 0, y: 0, active: false };
    let particles: { x: number; y: number; vx: number; vy: number }[] = [];
    let w = 0, h = 0, dpr = 1;
    const LINK_DIST = 130;
    const POINTER_RADIUS = 170;

    function resize() {
      if (!canvas || !hero) return;
      const r = hero.getBoundingClientRect();
      w = r.width; h = r.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Density scaled to area, capped for perf (main-thread budget)
      const count = Math.min(90, Math.max(28, Math.round((w * h) / 16000)));
      particles = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.28,
        vy: (Math.random() - 0.5) * 0.28,
      }));
    }

    function step(animate: boolean) {
      ctx.clearRect(0, 0, w, h);

      for (const p of particles) {
        if (animate) {
          // Cursor gently pushes nearby particles away — a clearing follows the pointer
          if (pointer.active) {
            const dx = p.x - pointer.x;
            const dy = p.y - pointer.y;
            const d = Math.hypot(dx, dy);
            if (d > 0 && d < POINTER_RADIUS) {
              const f = (1 - d / POINTER_RADIUS) * 0.6;
              p.vx += (dx / d) * f;
              p.vy += (dy / d) * f;
            }
          }
          p.x += p.vx;
          p.y += p.vy;
          // Damp so pushes settle back to a calm drift
          p.vx *= 0.96;
          p.vy *= 0.96;
          const minV = 0.12;
          if (Math.abs(p.vx) < minV) p.vx += (Math.random() - 0.5) * 0.05;
          if (Math.abs(p.vy) < minV) p.vy += (Math.random() - 0.5) * 0.05;

          if (p.x < 0) p.x += w; else if (p.x > w) p.x -= w;
          if (p.y < 0) p.y += h; else if (p.y > h) p.y -= h;
        }

        ctx.beginPath();
        ctx.arc(p.x, p.y, 1.6, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(26, 176, 255, 0.85)';
        ctx.fill();
      }

      // Links between near neighbours
      for (let i = 0; i < particles.length; i++) {
        const a = particles[i];
        for (let j = i + 1; j < particles.length; j++) {
          const b = particles[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const d = Math.hypot(dx, dy);
          if (d < LINK_DIST) {
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.strokeStyle = `rgba(122, 180, 255, ${(1 - d / LINK_DIST) * 0.22})`;
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }
        // Links to the pointer
        if (animate && pointer.active) {
          const dx = a.x - pointer.x, dy = a.y - pointer.y;
          const d = Math.hypot(dx, dy);
          if (d < POINTER_RADIUS) {
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(pointer.x, pointer.y);
            ctx.strokeStyle = `rgba(26, 176, 255, ${(1 - d / POINTER_RADIUS) * 0.35})`;
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }
      }
    }

    /* ---- rAF loop: eases parallax vars + renders particles ---- */
    let rafId = 0;
    let running = false;

    function frame() {
      curX += (targetX - curX) * 0.08;
      curY += (targetY - curY) * 0.08;
      hero!.style.setProperty('--mx', curX.toFixed(3));
      hero!.style.setProperty('--my', curY.toFixed(3));
      step(true);
      rafId = requestAnimationFrame(frame);
    }

    function start() {
      if (running || reduceMotion.matches) return;
      running = true;
      rafId = requestAnimationFrame(frame);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(rafId);
    }

    resize();
    window.addEventListener('resize', () => { resize(); if (reduceMotion.matches) step(false); });

    if (reduceMotion.matches) {
      // Static frame only — no animation, no parallax
      step(false);
    } else {
      // Pause when the hero scrolls out of view or the tab is hidden
      const io = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) start(); else stop();
      }, { threshold: 0.05 });
      io.observe(hero);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else if (hero.getBoundingClientRect().bottom > 0) start();
      });
    }

    reduceMotion.addEventListener('change', (e) => {
      if (e.matches) { stop(); hero.style.setProperty('--mx', '0'); hero.style.setProperty('--my', '0'); step(false); }
      else start();
    });
  }
</script>
