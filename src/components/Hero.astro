---
import CodeWindow from './CodeWindow.astro';
import HeroBackground from './HeroBackground';
import HeroContent from './HeroContent';
---

<section class="hero" id="hero">
  <div class="hero-backdrop" aria-hidden="true">
    <div class="hero-orb hero-orb--1"></div>
    <div class="hero-orb hero-orb--2"></div>
    <div class="hero-orb hero-orb--3"></div>
    <div class="hero-grid"></div>
    <!-- three.js WebGL particle field — island, hydrated when visible -->
    <HeroBackground client:visible />
  </div>

  <div class="container hero-inner">
    <!-- Copy + CTAs with framer-motion entrance — island, hydrated on load -->
    <HeroContent client:load />

    <div class="hero-visual">
      <div class="hero-visual-glow" aria-hidden="true"></div>
      <div class="hero-visual-inner">
        <CodeWindow />
      </div>

      <!--
        Floating proof chips orbiting the code window. They show capability
        rather than claim it (PRODUCT.md), turning the lone window into a
        "live build" scene. Decorative duplicates of real copy, so aria-hidden;
        float animations pause under prefers-reduced-motion (see styles).
      -->
      <div class="hero-chip hero-chip--ship" aria-hidden="true">
        <span class="hero-chip-pulse"></span>
        <span class="hero-chip-text">
          <strong>Shipped to production</strong>
          <span class="hero-chip-meta">build 0.42s · 0 errors</span>
        </span>
      </div>

      <div class="hero-chip hero-chip--score" aria-hidden="true">
        <span class="hero-chip-score">100</span>
        <span class="hero-chip-text">
          <strong>Lighthouse</strong>
          <span class="hero-chip-meta">performance</span>
        </span>
      </div>
    </div>
  </div>
</section>

<!--
  Styles are global (is:global) but every selector is namespaced under .hero,
  so they don't leak. This is required because the content lives in a React
  island (HeroContent.tsx) whose elements don't receive Astro's scoped-style
  attribute. The palette is reused verbatim from global.css design tokens.
-->
<style is:global>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(120% 90% at 78% -10%, color-mix(in oklab, var(--azure-700), transparent 70%), transparent 60%),
      linear-gradient(165deg, var(--navy-800), var(--navy-900) 72%);
    color: var(--on-dark);
    padding-block: clamp(7rem, 12vw, 10rem) clamp(4rem, 8vw, 7rem);
  }

  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* WebGL canvas sits above the static CSS layers, behind the content. */
  .hero-webgl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }

  /* Soft, blurred brand orbs for color depth (static, cheap). */
  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.5;
  }
  .hero-orb--1 {
    top: -12%;
    right: 2%;
    width: 38vw;
    max-width: 560px;
    aspect-ratio: 1;
    background: radial-gradient(circle, color-mix(in oklab, var(--pulse), transparent 35%), transparent 68%);
  }
  .hero-orb--2 {
    bottom: -18%;
    left: -6%;
    width: 42vw;
    max-width: 620px;
    aspect-ratio: 1;
    background: radial-gradient(circle, color-mix(in oklab, var(--azure), transparent 45%), transparent 68%);
  }
  .hero-orb--3 {
    top: 32%;
    left: 46%;
    width: 26vw;
    max-width: 360px;
    aspect-ratio: 1;
    opacity: 0.38;
    background: radial-gradient(circle, color-mix(in oklab, var(--azure-700), transparent 40%), transparent 70%);
  }

  /* Fine grid, faint, masked toward the top-right. */
  .hero-grid {
    position: absolute;
    inset: -4%;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 58px 58px;
    -webkit-mask-image: radial-gradient(120% 100% at 70% 0%, #000 35%, transparent 78%);
    mask-image: radial-gradient(120% 100% at 70% 0%, #000 35%, transparent 78%);
  }

  .hero-inner {
    position: relative;
    z-index: var(--z-base);
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
  }
  /* HeroContent hydrates inside an <astro-island> wrapper, which is the real
     grid child. Without min-width:0 on every grid item, the longest word can
     hold the track open wider than the viewport (headline overflow on mobile). */
  .hero-inner > * {
    min-width: 0;
  }

  .hero-content {
    min-width: 0;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--on-dark);
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: var(--space-6);
  }
  .hero-badge-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3ddc97;
    box-shadow: 0 0 0 4px color-mix(in oklab, #3ddc97, transparent 78%);
  }
  /* Living "available" indicator — a soft ring breathing outward. */
  .hero-badge-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #3ddc97;
    animation: hero-dot-pulse 2.4s var(--ease-out) infinite;
  }
  @keyframes hero-dot-pulse {
    0% { transform: scale(1); opacity: 0.6; }
    70%, 100% { transform: scale(2.6); opacity: 0; }
  }

  .hero h1 {
    color: #fff;
    font-size: var(--step-5);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-5);
    /* The headline controls its own breaks via <br>; balance fights that and
       can leave the accent line unwrapped/overflowing on narrow screens. */
    text-wrap: pretty;
  }
  .hero-accent {
    /* Plain inline on small screens so the phrase wraps with the headline.
       Becomes an inline-block positioning context for the SVG underline at
       ≥600px (see below), where it stays on one line. */
    color: var(--pulse);
  }
  /* Hand-drawn stroke beneath the accent words. The SVG is positioned to
     hug the baseline; framer-motion draws the path on load (HeroContent.tsx).
     Hidden on narrow screens where the phrase wraps — an underline spanning a
     wrapped box looks detached, and forcing one line would overflow. */
  .hero-accent-underline {
    display: none;
    position: absolute;
    left: -0.04em;
    right: -0.04em;
    bottom: -0.16em;
    width: calc(100% + 0.08em);
    height: 0.34em;
    overflow: visible;
    color: var(--pulse);
    filter: drop-shadow(0 2px 10px color-mix(in oklab, var(--pulse), transparent 55%));
    pointer-events: none;
  }
  /* Enough room for "moves you forward." on one line: keep it intact and
     reveal the drawn underline aligned to it. */
  @media (min-width: 600px) {
    .hero-accent {
      position: relative;
      display: inline-block;
      white-space: nowrap;
    }
    .hero-accent-underline { display: block; }
  }

  .hero-subtitle {
    color: var(--on-dark-muted);
    font-size: var(--step-1);
    line-height: 1.6;
    max-width: 52ch;
    margin-bottom: var(--space-7);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.25rem, 3.5vw, 2.5rem);
    margin: 0;
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  /* Hairline divider between stats reads them as one precise "ledger". */
  .hero-stat + .hero-stat {
    padding-left: clamp(1.25rem, 3.5vw, 2.5rem);
    border-left: 1px solid rgba(255, 255, 255, 0.1);
  }
  .hero-stat dt {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.02em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .hero-stat dd {
    margin: 0.45rem 0 0;
    font-size: 0.82rem;
    color: var(--on-dark-muted);
    letter-spacing: 0.005em;
  }

  .hero-visual {
    position: relative;
    /* Prevent the code window's min-content width from blowing out the grid
       track (minmax(auto,1fr)) and dragging the headline column wider than
       the viewport on mobile. The content column already sets min-width:0. */
    min-width: 0;
    animation: hero-rise 800ms var(--ease-out) 120ms both;
  }
  .hero-visual-glow {
    position: absolute;
    inset: -12% -8% -8% -4%;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--pulse), transparent 70%), transparent);
    filter: blur(8px);
    z-index: 0;
  }
  .hero-visual-inner {
    position: relative;
    z-index: 1;
    animation: hero-float 7s ease-in-out 1s infinite;
  }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  /* Gentle idle float for the code window — tactile depth without parallax JS. */
  @keyframes hero-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  /* ---- Floating proof chips ---------------------------------------- */
  /* Purposeful glass: two small status chips lifted off the code window
     to read as a live build. Sparing backdrop-blur, not decorative glass. */
  .hero-chip {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-md);
    background: color-mix(in oklab, var(--navy-800), transparent 22%);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: var(--shadow-lg);
    color: var(--on-dark);
    white-space: nowrap;
    opacity: 0;
    animation:
      hero-chip-in 600ms var(--ease-out) forwards,
      hero-chip-float 6.5s ease-in-out infinite;
  }
  .hero-chip-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    line-height: 1.2;
  }
  .hero-chip-text strong {
    font-size: 0.84rem;
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.01em;
  }
  .hero-chip-meta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--on-dark-muted);
  }

  .hero-chip--ship {
    top: 6%;
    right: -4%;
    animation-delay: 1.15s, 1.15s;
  }
  .hero-chip--score {
    bottom: 4%;
    left: -7%;
    animation-delay: 1.45s, 1.45s;
    animation-name: hero-chip-in, hero-chip-float-alt;
  }

  /* Live "shipping" indicator on the ship chip. */
  .hero-chip-pulse {
    position: relative;
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #3ddc97;
    box-shadow: 0 0 0 4px color-mix(in oklab, #3ddc97, transparent 80%);
  }
  .hero-chip-pulse::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #3ddc97;
    animation: hero-dot-pulse 2.4s var(--ease-out) infinite;
  }

  /* Lighthouse score badge — ring around a perfect 100. */
  .hero-chip-score {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: #fff;
    background: radial-gradient(circle at 50% 50%, color-mix(in oklab, var(--pulse), transparent 78%), transparent 72%);
    border: 1.5px solid color-mix(in oklab, var(--pulse), white 10%);
    box-shadow: inset 0 0 12px color-mix(in oklab, var(--pulse), transparent 70%);
  }

  @keyframes hero-chip-in {
    from { opacity: 0; transform: translateY(10px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  /* Two phase-offset float tracks so the chips don't bob in lockstep. */
  @keyframes hero-chip-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-9px); }
  }
  @keyframes hero-chip-float-alt {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(7px); }
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .hero-visual { order: 2; }
    /* Pull chips inside the visual bounds so they don't clip on the edge. */
    .hero-chip--ship { right: 0; }
    .hero-chip--score { left: 0; }
  }

  /* On the smallest screens the chips crowd the code window — drop them. */
  @media (max-width: 480px) {
    .hero-chip { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-visual,
    .hero-visual-inner,
    .hero-badge-dot::after,
    .hero-chip-pulse::after { animation: none; }
    /* Chips default to opacity:0 for their entrance — show them at rest. */
    .hero-chip { animation: none; opacity: 1; }
  }
</style>
