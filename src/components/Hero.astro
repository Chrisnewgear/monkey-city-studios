---
import CodeWindow from './CodeWindow.astro';

const stats = [
  { value: "100+", label: "Projects shipped" },
  { value: "98%", label: "Client satisfaction" },
  { value: "5+", label: "Years building" },
];
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-content">
      <span class="hero-badge">
        <span class="hero-badge-dot"></span>
        Digital product studio · Available for new work
      </span>

      <h1>
        We build software that<br />
        <span class="hero-accent">moves you forward.</span>
      </h1>

      <p class="hero-subtitle">
        Monkey City Studios partners with founders and growing teams to design,
        engineer, and ship ambitious web and mobile products — from first
        concept to scaled platform.
      </p>

      <div class="hero-cta">
        <a href="/contact" class="btn btn--primary btn--lg">
          Start your project
          <svg class="btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="#tech-stack" class="btn btn--ghost-light btn--lg">View our stack</a>
      </div>

      <dl class="hero-stats">
        {stats.map((stat) => (
          <div class="hero-stat">
            <dt>{stat.value}</dt>
            <dd>{stat.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hero-visual">
      <div class="hero-visual-glow" aria-hidden="true"></div>
      <CodeWindow />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--navy-900);
    color: var(--on-dark);
    padding-block: clamp(7rem, 12vw, 10rem) clamp(4rem, 8vw, 7rem);
  }

  /* Layered, static brand field — controlled glow + fine grid, no rainbow churn */
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 55% at 82% 8%, color-mix(in oklab, var(--pulse), transparent 62%), transparent 60%),
      radial-gradient(70% 60% at 8% 95%, color-mix(in oklab, var(--azure-700), transparent 55%), transparent 65%),
      linear-gradient(160deg, var(--navy-800), var(--navy-900) 70%);
  }
  .hero-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(120% 100% at 70% 0%, #000 35%, transparent 78%);
    mask-image: radial-gradient(120% 100% at 70% 0%, #000 35%, transparent 78%);
  }

  .hero-inner {
    position: relative;
    z-index: var(--z-base);
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  .hero-content {
    animation: rise 700ms var(--ease-out) both;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--on-dark);
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: var(--space-6);
  }
  .hero-badge-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #3ddc97;
    box-shadow: 0 0 0 4px color-mix(in oklab, #3ddc97, transparent 78%);
  }
  /* Living "available" indicator — a soft ring breathing outward */
  .hero-badge-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #3ddc97;
    animation: dot-pulse 2.4s var(--ease-out) infinite;
  }
  @keyframes dot-pulse {
    0% { transform: scale(1); opacity: 0.6; }
    70%, 100% { transform: scale(2.6); opacity: 0; }
  }

  .hero h1 {
    color: #fff;
    font-size: var(--step-5);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-5);
  }
  .hero-accent { color: var(--pulse); }

  .hero-subtitle {
    color: var(--on-dark-muted);
    font-size: var(--step-1);
    line-height: 1.6;
    max-width: 52ch;
    margin-bottom: var(--space-7);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin: 0;
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  /* Stagger the stats in after the content block settles */
  .hero-stat {
    opacity: 0;
    animation: rise 600ms var(--ease-out) both;
  }
  .hero-stat:nth-child(1) { animation-delay: 420ms; }
  .hero-stat:nth-child(2) { animation-delay: 480ms; }
  .hero-stat:nth-child(3) { animation-delay: 540ms; }
  .hero-stat dt {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .hero-stat dd {
    margin: 0.4rem 0 0;
    font-size: 0.85rem;
    color: var(--on-dark-muted);
  }

  .hero-visual {
    position: relative;
    animation: rise 800ms var(--ease-out) 120ms both;
  }
  .hero-visual-glow {
    position: absolute;
    inset: -12% -8% -8% -4%;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--pulse), transparent 70%), transparent);
    filter: blur(8px);
    z-index: 0;
  }
  .hero-visual :global(.code-window) {
    position: relative;
    z-index: 1;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .hero-visual { order: 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-content,
    .hero-visual,
    .hero-badge-dot::after { animation: none; }
    .hero-stat { opacity: 1; animation: none; }
  }
</style>
