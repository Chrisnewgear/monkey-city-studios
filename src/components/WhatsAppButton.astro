---
/*
  Site-wide floating WhatsApp button. Lives in BaseLayout so it persists on
  every page. The href uses the wa.me deep link (digits only — no "+" or
  spaces). `message` pre-fills the chat to lower the friction of starting one.
*/
interface Props {
  phone?: string;
  message?: string;
}

const {
  // Digits only: +593 96 378 7611 → 593963787611
  phone = '593963787611',
  message = "Hi Monkey City Studios! I'd like to talk about a project.",
} = Astro.props;

const href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<a
  class="wa-fab"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with us on WhatsApp"
>
  <span class="wa-fab-pulse" aria-hidden="true"></span>
  <svg class="wa-fab-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.02ZM12.05 20.15h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24a8.2 8.2 0 0 1 8.23 8.25c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"
    ></path>
  </svg>
</a>

<style>
  .wa-fab {
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: clamp(1rem, 3vw, 1.75rem);
    z-index: var(--z-toast, 1000);
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    color: #fff;
    background: #25d366;
    box-shadow:
      0 8px 24px color-mix(in oklab, #25d366, transparent 55%),
      0 4px 12px rgba(0, 0, 0, 0.25);
    transition:
      transform 0.2s var(--ease-out, ease),
      box-shadow 0.2s var(--ease-out, ease);
  }

  .wa-fab:hover {
    transform: scale(1.08);
    box-shadow:
      0 10px 30px color-mix(in oklab, #25d366, transparent 40%),
      0 6px 16px rgba(0, 0, 0, 0.3);
  }

  .wa-fab:focus-visible {
    outline: 3px solid color-mix(in oklab, #25d366, white 25%);
    outline-offset: 3px;
  }

  .wa-fab-icon {
    position: relative;
    width: 1.85rem;
    height: 1.85rem;
  }

  /* Soft breathing ring that draws the eye without being noisy. */
  .wa-fab-pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #25d366;
    z-index: -1;
    animation: wa-fab-pulse 2.4s var(--ease-out, ease-out) infinite;
  }

  @keyframes wa-fab-pulse {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    70%,
    100% {
      transform: scale(1.9);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-fab {
      transition: none;
    }
    .wa-fab-pulse {
      animation: none;
    }
  }
</style>
