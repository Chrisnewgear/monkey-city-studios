---
import { services } from "../data/services";
---

<section class="services section" id="services">
  <div class="container">
    <div class="section-head reveal">
      <span class="section-kicker">What we do</span>
      <h2>End-to-end product capability, under one roof.</h2>
      <p class="section-lead">
        From the first whiteboard sketch to a platform serving real users — we
        cover the full lifecycle so you never hand off between vendors.
      </p>
    </div>

    <div class="bento" data-reveal-stagger>
      {services.map((service) => (
        <article class={`service reveal ${service.featured ? "service--featured" : ""}`} style={`--span: ${service.span}`}>
          <div class="service-top">
            <span class="service-icon" set:html={service.icon} />
            {service.tags && (
              <ul class="service-tags">
                {service.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            )}
          </div>
          <div class="service-body">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
          <a class="service-link" href={`/services/${service.slug}`} aria-label={`Learn more about ${service.title}`}>
            Learn more
            <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </article>
      ))}

      <a class="service service--cta reveal" href="/contact" style="--span: span 5">
        <h3>Have something else in mind?</h3>
        <p>Tell us what you're building — we'll shape the right team around it.</p>
        <span class="service-link service-link--bright">
          Start a conversation
          <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--bg);
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--space-5);
  }

  .service {
    grid-column: var(--span);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    box-shadow: var(--shadow-sm);
    transition: transform 280ms var(--ease-out), box-shadow 280ms var(--ease-out),
      border-color 280ms var(--ease-out);
  }

  .service:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: color-mix(in oklab, var(--azure), white 55%);
  }

  .service-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .service-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    background: color-mix(in oklab, var(--azure), white 86%);
    color: var(--azure-700);
    flex-shrink: 0;
    transition: background 280ms var(--ease-out), color 280ms var(--ease-out);
  }
  .service:hover .service-icon {
    background: var(--azure);
    color: #fff;
  }

  .service-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .service-tags li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
  }

  .service-body { flex: 1; }
  .service-body h3 {
    color: var(--ink);
    margin-bottom: var(--space-2);
  }
  .service-body p {
    color: var(--muted);
    margin: 0;
    font-size: 0.975rem;
  }

  .service--featured {
    background:
      radial-gradient(120% 120% at 100% 0%, color-mix(in oklab, var(--azure), white 90%), transparent 55%),
      var(--surface);
  }
  .service--featured h3 { font-size: var(--step-2); }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--azure-700);
    margin-top: auto;
  }

  .service--cta {
    grid-column: var(--span);
    justify-content: center;
    background: linear-gradient(150deg, var(--navy-800), var(--navy-900));
    border-color: transparent;
    color: var(--on-dark);
  }
  .service--cta h3 { color: #fff; }
  .service--cta p { color: var(--on-dark-muted); margin: 0; }
  .service--cta:hover {
    border-color: transparent;
    box-shadow: var(--shadow-lg);
  }
  .service-link--bright { color: var(--pulse); }

  @media (max-width: 900px) {
    .service { grid-column: span 6 !important; }
    .service--featured,
    .service--cta { grid-column: span 12 !important; }
  }

  @media (max-width: 600px) {
    .service { grid-column: span 12 !important; }
  }
</style>
