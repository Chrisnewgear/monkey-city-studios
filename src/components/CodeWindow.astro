---
---
<div class="code-window">
  <div class="window-header">
    <div class="window-dots" aria-hidden="true">
      <span class="window-dot dot-red"></span>
      <span class="window-dot dot-yellow"></span>
      <span class="window-dot dot-green"></span>
    </div>
    <div class="window-title">build-your-idea.ts</div>
  </div>
  <pre class="code-content"><code><span class="code-line"><span class="line-number">1</span><span class="keyword">const</span> <span class="variable">product</span> = <span class="function">launch</span>(<span class="string">'your-idea'</span>, &#123;</span>
<span class="code-line"><span class="line-number">2</span>  <span class="property">scalable</span>: <span class="keyword">true</span>,</span>
<span class="code-line"><span class="line-number">3</span>  <span class="property">performance</span>: <span class="string">'optimized'</span>,</span>
<span class="code-line"><span class="line-number">4</span>  <span class="property">design</span>: <span class="string">'crafted'</span>,</span>
<span class="code-line"><span class="line-number">5</span>&#125;);</span>
<span class="code-line"><span class="line-number">6</span><span class="comment">// from concept to shipped — fast</span></span>
<span class="code-line"><span class="line-number">7</span><span class="variable">product</span>.<span class="function">ship</span>();<span class="cursor"></span></span></code></pre>
</div>

<style>
  .code-window {
    background: color-mix(in oklab, var(--navy-900), black 22%);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.4rem 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: var(--shadow-lg);
  }

  .window-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .window-dots { display: flex; gap: 0.45rem; }
  .window-dot { width: 11px; height: 11px; border-radius: 50%; }
  .dot-red { background: #ff5f57; }
  .dot-yellow { background: #ffbd2e; }
  .dot-green { background: #28ca42; }

  .window-title {
    color: rgba(255, 255, 255, 0.55);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .code-content {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.75;
    overflow-x: auto;
    color: #d6e3f5;
  }
  .code-content code { display: block; }

  .code-line {
    display: block;
    opacity: 0;
    animation: codeIn 0.4s var(--ease-out) forwards;
  }
  .code-line:nth-child(1) { animation-delay: 0.4s; }
  .code-line:nth-child(2) { animation-delay: 0.55s; }
  .code-line:nth-child(3) { animation-delay: 0.7s; }
  .code-line:nth-child(4) { animation-delay: 0.85s; }
  .code-line:nth-child(5) { animation-delay: 1s; }
  .code-line:nth-child(6) { animation-delay: 1.15s; }
  .code-line:nth-child(7) { animation-delay: 1.3s; }

  @keyframes codeIn {
    from { opacity: 0; transform: translateX(-6px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .line-number {
    display: inline-block;
    width: 1.6rem;
    margin-right: 1rem;
    color: rgba(255, 255, 255, 0.28);
    text-align: right;
    user-select: none;
  }

  .keyword { color: #c792ea; }
  .string { color: #c3e88d; }
  .function { color: #82aaff; }
  .property { color: #ffcb6b; }
  .comment { color: #6b7a99; font-style: italic; }
  .variable { color: #f07178; }

  .cursor {
    display: inline-block;
    width: 8px;
    height: 1.05em;
    margin-left: 3px;
    vertical-align: text-bottom;
    background: var(--pulse);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .code-line { opacity: 1; animation: none; }
    .cursor { animation: none; }
  }
</style>
