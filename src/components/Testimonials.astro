---
const testimonials = [
  {
    name: "John Doe",
    role: "CEO",
    company: "Tech Innovations",
    feedback:
      "Monkey City Studios transformed our online presence. The team understood our vision instantly and delivered beyond what we imagined.",
  },
  {
    name: "Jane Smith",
    role: "Founder",
    company: "Creative Solutions",
    feedback:
      "Professional, communicative, and shipped on time. They felt like an extension of our own team rather than an outside vendor.",
  },
  {
    name: "Alice Johnson",
    role: "Head of Product",
    company: "Marketing Gurus",
    feedback:
      "Exceptional craft and support throughout the project. We've already started our next build with them.",
  },
];

const initials = (name: string) =>
  name.split(" ").map((p) => p[0]).slice(0, 2).join("");
---

<section class="testimonials section" id="testimonials">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="section-kicker section-kicker--light">Client stories</span>
      <h2>Trusted by teams who ship.</h2>
      <p class="section-lead">
        We measure success by what our partners build after we hand off.
      </p>
    </div>

    <div class="testimonial-list">
      {testimonials.map((t) => (
        <figure class="testimonial">
          <svg class="quote-mark" width="34" height="34" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M9.6 6C6.5 6 4 8.6 4 11.8V18h6.4v-6.4H7.2c0-1.8 1.1-3 2.4-3.2V6zm9.2 0c-3.1 0-5.6 2.6-5.6 5.8V18H19.6v-6.4h-3.2c0-1.8 1.1-3 2.4-3.2V6z"/>
          </svg>
          <blockquote>{t.feedback}</blockquote>
          <figcaption class="testimonial-author">
            <span class="avatar" aria-hidden="true">{initials(t.name)}</span>
            <span class="author-meta">
              <span class="author-name">{t.name}</span>
              <span class="author-role">{t.role}, {t.company}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials {
    position: relative;
    overflow: hidden;
    background: var(--navy-900);
    color: var(--on-dark);
  }
  .testimonials::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(55% 50% at 85% 10%, color-mix(in oklab, var(--pulse), transparent 78%), transparent 60%),
      radial-gradient(55% 55% at 5% 100%, color-mix(in oklab, var(--azure-700), transparent 70%), transparent 65%);
  }

  .testimonials .container { position: relative; z-index: 1; }

  .testimonials h2 { color: #fff; }
  .testimonials .section-lead { color: var(--on-dark-muted); }
  .section-kicker--light { color: var(--pulse); }
  .section-kicker--light::before { background: var(--pulse); }

  .testimonial-list {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .testimonial {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    transition: transform 280ms var(--ease-out), border-color 280ms var(--ease-out),
      background 280ms var(--ease-out);
  }
  .testimonial:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.24);
  }

  .quote-mark { color: var(--pulse); opacity: 0.85; }

  blockquote {
    margin: 0;
    flex: 1;
    color: #eef4fb;
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 50%;
    background: linear-gradient(140deg, var(--azure), var(--azure-700));
    color: #fff;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .author-meta { display: flex; flex-direction: column; line-height: 1.3; }
  .author-name { color: #fff; font-weight: 600; }
  .author-role { color: var(--on-dark-muted); font-size: 0.85rem; }
</style>
